generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model draft_messages {
  id          BigInt   @id @default(autoincrement())
  from_number String?  @db.VarChar
  to_number   String?  @db.VarChar
  message     String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model inventory {
  id              BigInt      @id @default(autoincrement())
  created_at      DateTime    @default(now()) @db.Timestamptz(6)
  pharmacy_id     Int?
  en_name         String?
  ar_name         String?
  price           Decimal?    @db.Decimal(10, 2)
  units_count     Float?
  dosage_form     String?
  drug_type       String?     @db.VarChar
  active_material String?     @db.VarChar
  quantity        Float?      @default(0)
  pharmacies      pharmacies? @relation(fields: [pharmacy_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model notification {
  id          BigInt           @id @default(autoincrement())
  user_id     Int?
  pharmacy_id Int?
  type        NotificationType
  target_role TargetRole
  title       String
  body        String
  data        Json?
  is_read     Boolean          @default(false)
  read_at     DateTime?
  created_at  DateTime         @default(now())
  pharmacy    pharmacies?      @relation(fields: [pharmacy_id], references: [id], onDelete: Cascade)
  user        users?           @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, is_read])
  @@index([pharmacy_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model system_log {
  id          BigInt      @id @default(autoincrement())
  user_id     BigInt?
  pharmacy_id Int?
  action      String
  entity_type String?
  entity_id   BigInt?
  metadata    Json?
  created_at  DateTime    @default(now())
  pharmacy    pharmacies? @relation(fields: [pharmacy_id], references: [id], onDelete: Cascade)

  @@index([pharmacy_id])
  @@index([action])
  @@index([created_at])
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model message_types {
  id           Int        @id @default(autoincrement())
  message_type String     @db.VarChar
  messages     messages[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model messages {
  id                BigInt        @id @default(autoincrement())
  message           String?
  created_at        DateTime      @default(now()) @db.Timestamptz(6)
  pharmacy_id       Int
  from_number       String        @db.VarChar
  to_number         String        @db.VarChar
  log               String        @db.VarChar
  image_url         String?       @db.VarChar
  album_id          String?       @db.VarChar
  confidence        Float?        @db.Real
  original_id       String?       @unique @db.VarChar(100)
  quoted_message_id String?       @db.VarChar(100)
  input_tokens      Int           @default(0)
  output_tokens     Int           @default(0)
  message_type      Int
  message_types     message_types @relation(fields: [message_type], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pharmacies        pharmacies    @relation(fields: [pharmacy_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([pharmacy_id, from_number, created_at(sort: Desc)])
  @@index([pharmacy_id, to_number, created_at(sort: Desc)])
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model pharmacies {
  id               Int             @id @default(autoincrement())
  pharmacy_name    String          @db.VarChar(50)
  pharmacy_address String          @db.VarChar(50)
  delivery         Boolean         @default(false)
  work_time        String          @default("24 ساعة في اليوم 7 أيام في الأسبوع") @db.VarChar(50)
  logo             String?         @default("https://jypewluarjjsrkpicipv.supabase.co/storage/v1/object/public/avatars/ph_avatar.png") @db.VarChar
  is_active        Boolean         @default(true)
  created_at       DateTime        @default(now()) @db.Timestamptz(6)
  delivery_price   Decimal         @default(0.00) @db.Decimal
  inventory        inventory[]
  messages         messages[]
  notifications    notification[]
  subsriptions     subscriptions[]
  system_logs      system_log[]
  users            users[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model user_roles {
  id        Int     @id @default(autoincrement())
  role_name String  @db.VarChar
  users     users[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model users {
  id              Int            @id @default(autoincrement())
  username        String         @db.VarChar(50)
  password        String         @db.VarChar
  mobile          String         @unique @db.VarChar(13)
  avatar          String?        @default("https://jypewluarjjsrkpicipv.supabase.co/storage/v1/object/public/avatars/avatar.png") @db.VarChar
  created_at      DateTime       @default(now()) @db.Timestamptz(6)
  pharmacy_id     Int
  is_logging_in   Boolean        @default(false)
  is_active       Boolean        @default(true)
  last_login_at   DateTime?      @db.Timestamptz(6)
  ai_mode         Boolean        @default(true)
  instance_name   String?
  fcm_token       String[]       @default([])
  instance_status String?        @db.VarChar
  role_id         Int
  contacts        contacts[]
  notifications   notification[]
  pharmacies      pharmacies     @relation(fields: [pharmacy_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user_roles      user_roles     @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model contacts {
  id             BigInt   @id @default(autoincrement())
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  contact_mobile String   @db.VarChar
  contact_name   String?  @db.VarChar
  user_mobile    String   @db.VarChar
  users          users    @relation(fields: [user_mobile], references: [mobile], onDelete: NoAction, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model executions {
  id            String     @id @unique
  workflow_name String?    @db.VarChar
  from_number   String?    @db.VarChar
  to_number     String?    @db.VarChar
  n8n_logs      n8n_logs[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model n8n_logs {
  id            BigInt      @id @default(autoincrement())
  executed_node String?     @db.VarChar
  message       String?
  created_at    DateTime    @default(now()) @db.Timestamptz(6)
  execution_id  String?     @db.VarChar
  executions    executions? @relation(fields: [execution_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model blocked_contacts {
  contact_number       String    @id @db.VarChar
  ten_minutes_messages Int?
  daily_messages       Int?
  pharmacy_id Int?
  blocked              Boolean   @default(false)
  blocked_until        DateTime? @db.Timestamptz(6)
  alerted              Boolean   @default(false)
}

model plans {
  id                 Int             @id @default(autoincrement())
  name               String          @db.VarChar(50)
  messages_limit     Int
  price              Decimal         @db.Decimal
  common_replies     Boolean         @default(true)
  order_notification Boolean         @default(false)
  basic_dashboard    Boolean         @default(true)
  advanced_dashboard Boolean         @default(false)
  images_limit       Int             @default(0)
  subscriptions      subscriptions[]
}

model subscriptions {
  id                        Int                         @id @default(autoincrement())
  pharmacy_id               Int
  plan_id                   Int
  subscription_state        PlanState                   @default(ACTIVE)
  subscription_start        DateTime                    @default(now()) @db.Timestamp(6)
  messages_used             Int
  next_month_paid           Boolean                     @default(false)
  bill_due                  DateTime                    @db.Date
  images_used               Int                         @default(0)
  monthly_subscription_logs monthly_subscription_logs[]
  pharmacies                pharmacies                  @relation(fields: [pharmacy_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  plans                     plans                       @relation(fields: [plan_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([pharmacy_id])
}

model monthly_subscription_logs {
  id               BigInt        @id @default(autoincrement())
  pharmacy_plan_id Int
  billing_month    DateTime      @default(now()) @db.Date
  messages_used    Int
  images_used      Int           @default(0)
  amount_paid      Decimal       @db.Decimal(10, 2)
  discount         Decimal       @db.Decimal(10, 2)
  created_at       DateTime      @default(now())
  subscriptions    subscriptions @relation(fields: [pharmacy_plan_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([billing_month])
}

enum NotificationType {
  ORDER_REQUEST
  USER_AUTH
  SUBSCRIPTION_RENEWED
  SUBSCRIPTION_SUSPENDED
  AI_TOGGLED
  SYSTEM_ALERT
  SYSTEM_ERROR
  INVENTORY_UPDATED
  NEW_USER
  NEW_INSTANCE
}

enum TargetRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum PlanState {
  ACTIVE
  SUSPENDED
  EXPIRED
  CANCELED
}
